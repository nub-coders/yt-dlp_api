# ── Telegram Bot API Credentials ───────────────────────────────────────────────
API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627

# Generate BOT_TOKEN using @BotFather on Telegram
BOT_TOKEN=1234567890:YOUR_BOT_TOKEN_HERE

# Support group and update channel user names (without '@')
TG_GROUP=nub_coder_s
TG_CHANNEL=nub_coders

# Space-separated list of Telegram User IDs who have administrative privileges
ADMIN_IDS="6076474757 2128132096 8186766999 8203475541"

# ── Redis Configuration ─────────────────────────────────────────────────────────
# Connection details for Redis caching & rate limiting
REDIS_HOST=localhost
REDIS_PORT=15440
REDIS_USERNAME=default
REDIS_PASSWORD=

# ── API Rate Limits ─────────────────────────────────────────────────────────────
# Default daily request counts allowed per user/admin token
DAILY_LIMIT=1000
ADMIN_LIMIT=10000

# ── Cookies ──────────────────────────────────────────────────────────────────
# yt-dlp cookies file. Exported at startup from COOKIES_BROWSER, then reused and
# re-exported every COOKIES_REFRESH_HOURS (0 disables refresh).
COOKIES_FILE=cookies.txt
COOKIES_BROWSER=firefox
COOKIES_BOOTSTRAP_URL=https://www.youtube.com/watch?v=BaW_jenozKc
COOKIES_REFRESH_HOURS=6

# ── Deployment Host ────────────────────────────────────────────────────────────
API_HOST=api.nubcoders.com

# ── Public API Base URL ────────────────────────────────────────────────────────
BASE_URL=https://api.nubcoders.com
